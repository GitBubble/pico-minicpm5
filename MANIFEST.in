include LICENSE NOTICE THIRD_PARTY_NOTICES.md MODEL_PROVENANCE.md
include README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CITATION.cff
recursive-include configs *.json
recursive-include docs *.md
recursive-include experimental *.md
recursive-include release *.json *.md
recursive-include schemas *.json
recursive-include tests *.py
global-exclude *.om *.onnx *.safetensors *.image_list *.bin *.so *.dylib *.dll
global-exclude .DS_Store
prune artifacts
prune work
