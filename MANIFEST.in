include LICENSE NOTICE THIRD_PARTY_NOTICES.md MODEL_PROVENANCE.md
include README.md README.zh-CN.md CHANGELOG.md CONTRIBUTING.md SECURITY.md CITATION.cff
recursive-include app *.py *.c Makefile *.sh *.md *.json
recursive-include app/lib *.md SHA256SUMS
recursive-include configs *.json
recursive-include docs *.md
recursive-include experimental *.md
recursive-include release *.json *.md
recursive-include schemas *.json
recursive-include tests *.py
global-exclude *.om *.onnx *.safetensors *.image_list *.bin *.dylib *.dll
global-exclude *.so
global-exclude .DS_Store
prune artifacts
prune work
